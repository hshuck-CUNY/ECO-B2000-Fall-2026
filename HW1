#set working directory
setwd(InputDirectory)

#call data
load("d_HHP2020_24.RData")
#glimpse(d_HHP2020_24) try this later
d_HHP2020_24[1:10,1:6]

attach(d_HHP2020_24)
#average income by region
d_HHP2020_24 %>%
  group_by(Region, work_kind) %>%
  summarise(
    avg_income = mean(income_midpoint, na.rm = TRUE),
    .groups = "drop"
  ) %>%
  ggplot(aes(work_kind, avg_income, fill = work_kind)) +
  geom_col() +
  facet_wrap(~ Region) +
  labs(
    x = "Work Type",
    y = "Income"
  ) +
  theme_minimal() +
  theme(axis.text.x = element_text(angle = 90), legend.position = "none")

# Create income groups
d_HHP2020_24 <- d_HHP2020_24 %>%
  mutate(
    income_group = case_when(
      income_midpoint < 40000 ~ "<$40k",
      income_midpoint >= 40000 & income_midpoint < 62500 ~ "$40k-$62.5k",
      income_midpoint >= 62500 & income_midpoint < 82500 ~ "$62.5k-$82.5k",
      income_midpoint >= 82500 & income_midpoint < 125000 ~ "$82.5k-$125k",
      income_midpoint >= 125000 & income_midpoint < 225000 ~ "$125k-$225k",
      income_midpoint >= 225000 ~ "$225k+",
      TRUE ~ NA_character_
    )
  )

# income by work kind and education
income_education <- d_HHP2020_24 %>%
  group_by(Region, Education, income_group) %>%
  summarise(
    n_obs = n(),
    .groups = "drop"
  ) %>%
  group_by(Region,Education) %>%
  mutate(
    pct = n_obs / sum(n_obs)
  ) %>%
  ungroup()

# Plot
ggplot(d_HHP2020_24,
       aes(x = Education,
           fill = income_group)) +
  geom_bar(position = "fill") +
  facet_wrap(~ work_kind) +
  scale_y_continuous(
    labels = function(x) paste0(round(100 * x), "%")
  ) +
  labs(
    x = "Education",
    y = "Income Proportion",
    fill = "Income Group",
    title = "Income Distribution by Education and Work Type"
  ) +
  theme_minimal() +
  theme(
    axis.text.x = element_text(angle = 45, hjust = 1)
  )

